{
  "skill_id": "de_ecom_02_sk01",
  "name": "商品知识库问答",
  "type": "atomic",
  "input": {
    "type": "object",
    "required": ["kb", "questions"],
    "properties": {
      "kb": {
        "type": "array",
        "description": "知识库条目，每条含 id/类目/问题/关键词/答案；唯一作答依据",
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "string"},
            "类目": {"type": "string"},
            "问题": {"type": "string"},
            "关键词": {"type": "array", "items": {"type": "string"}},
            "答案": {"type": "string"}
          }
        }
      },
      "questions": {
        "type": "array",
        "description": "买家问题列表",
        "items": {
          "type": "object",
          "properties": {
            "买家": {"type": "string"},
            "问题": {"type": "string"}
          }
        }
      },
      "min_score": {
        "type": "number",
        "description": "命中阈值，默认 0.35",
        "default": 0.35
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["summary", "results", "gaps"],
    "properties": {
      "summary": {
        "type": "object",
        "description": "检索结论：问题总数 / 命中数 / 未命中数 / 命中率 / 命中阈值 / 涉及类目数"
      },
      "results": {
        "type": "array",
        "description": "逐条问答结果，含命中的知识条目 ID 与标准答复",
        "items": {
          "type": "object",
          "properties": {
            "买家": {"type": "string"},
            "买家问题": {"type": "string"},
            "是否命中": {"type": "string", "enum": ["✅", "❌"]},
            "知识类目": {"type": "string"},
            "匹配度": {"type": "number"},
            "置信度": {"type": "string", "enum": ["高", "中", "低", "未命中"]},
            "命中条目ID": {"type": "string"},
            "标准答复": {"type": "string"}
          }
        }
      },
      "gaps": {
        "type": "array",
        "description": "知识缺口：未命中问题与建议补充的条目",
        "items": {
          "type": "object",
          "properties": {
            "买家问题": {"type": "string"},
            "最相近条目": {"type": "string"},
            "最高匹配度": {"type": "number"},
            "缺口类型": {"type": "string"}
          }
        }
      }
    },
    "x-rendered-from": "capability:retrieve"
  },
  "scripts": {
    "retrieve": "scripts/kb_qa.py",
    "usage": "python3 scripts/kb_qa.py --input input.json --outdir out"
  },
  "artifacts": ["out/知识库问答结果.xlsx", "out/类目命中分布.png", "out/kb_qa.json"],
  "constraints": {
    "max_input_length": 20000,
    "forbidden_words": ["最好", "第一", "100%"],
    "ai_label_required": true,
    "human_review_required": true,
    "external_api_required": false
  }
}
